<Project Sdk="Microsoft.NET.Sdk.Worker">

  <ItemGroup>
    <ProjectReference Include="..\Relay.Application\Relay.Application.csproj" />
    <ProjectReference Include="..\Relay.Infrastructure\Relay.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Provider assemblies are matched by wildcard, not enumerated.

    This is the mechanism behind the projects zero-edit extensibility claim:
    adding a sixth provider means adding a folder under src/, and nothing else.
    If this were a hand-maintained list, every new provider would require an edit
    to both host projects — which is exactly the coupling the plugin design
    exists to remove, reintroduced one layer down in the build.

    Abstractions is excluded because it is the contract, not an implementation of it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Relay.Providers.*\*.csproj"
                      Exclude="..\Relay.Providers.Abstractions\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>
