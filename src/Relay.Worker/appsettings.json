{
  "ConnectionStrings": {
    "Relay": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Pipeline": {
    "BatchSize": 25,
    "DispatchInterval": "00:00:01",
    "DispatchMaxInterval": "00:00:15",
    "ReconciliationInterval": "00:05:00",
    "RecoveryInterval": "00:01:00",
    "StuckDispatchAfter": "00:05:00",
    "OutboxInterval": "00:00:01",
    "OutboxMaxInterval": "00:00:10"
  },
  "Delivery": {
    "Routing": {
      "DefaultPriority": 100,
      "Priorities": {
        "email.postal": 10
      }
    }
  },
  "Providers": {
    "email.postal": {
      "BaseUrl": "",
      "ApiKey": "",
      "FromAddress": "",
      "Timeout": "00:00:10"
    }
  }
}
