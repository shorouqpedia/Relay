<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One test suite, run once per provider assembly.

    The suite is an abstract base class asserting the behaviour every provider
    must exhibit — including the unhappy parts of the contract: surfacing a
    transient failure as retryable, honouring Retry-After, never throwing a
    vendor exception type across the boundary, and being safe to call twice with
    the same idempotency key. Each provider adds a sealed subclass and nothing
    else. If a provider cannot pass it, the abstraction is wrong, not the test.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Relay.Providers.*\*.csproj" />

    <!--
      Referenced so the decorator-chain tests can compose the real container.
      Those assert the ordering in ADR 0007, which is invisible at every call
      site and would otherwise survive being reordered by a refactor.
    -->
    <ProjectReference Include="..\..\src\Relay.Infrastructure\Relay.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Refit" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
