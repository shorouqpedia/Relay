<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Stand-in upstreams for local development and integration tests.

    These deliberately misbehave on demand: slow responses, 429s with Retry-After,
    intermittent 500s, delivery receipts that arrive late, arrive twice, or never
    arrive at all. Testing the happy path against a real provider sandbox proves
    very little; the failure modes are the part worth having a test for.
  -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    References the provider contract only for CallbackSignature, so the fakes sign
    receipts exactly the way the real providers verify them. Signing them
    independently would have meant two implementations that could drift, and the
    stack would then prove nothing about the verifier.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Relay.Providers.Abstractions\Relay.Providers.Abstractions.csproj" />
  </ItemGroup>

</Project>
